+++ b/paddlex/inference/models/runners/ais_bench_runner.py
@@ -0,0 +1,72 @@
+import os
+from pathlib import Path
+import acl
+import platform
+
+import numpy as np
+
+from .inference_runner import InferenceRunner
+
+ARCH_ALIASES = {
+    "arm64": "aarch64",
+    "aarch64": "aarch64",
+    "amd64": "x86_64",
+    "x86_64": "x86_64",
+}
+
+ACL_ERROR_REPEAT_INITIALIZE = 100002
+
+
+def _get_soc_version():
+    configured = os.getenv("ASCEND_SOC_VERSION")
+    if configured:
+        return configured
+
+    ret = acl.init()
+    if ret not in (0, ACL_ERROR_REPEAT_INITIALIZE):
+        raise RuntimeError(f"acl.init failed with error code {ret}")
+
+    soc_version = acl.get_soc_name()
+    if not soc_version:
+        raise RuntimeError("Failed to detect Ascend SoC version")
+    return soc_version
+
+
+class AisBenchRunner(InferenceRunner):
+    def __init__(self, model_dir, device_id=0):
+        from ais_bench.infer.interface import InferSession
+        soc_version = _get_soc_version()
+        arch = ARCH_ALIASES.get(platform.machine().lower(), platform.machine().lower())
+
+        self.model_path = Path(model_dir) / f"inference-{soc_version}_{arch}.om"
+        if not self.model_path.is_file():
+            raise FileNotFoundError(f"OM model not found: {self.model_path}")
+
+        self.session = InferSession(
+            device_id=device_id,
+            model_path=str(self.model_path),
+        )
+        self.output_size = int(
+            os.getenv("AIS_BENCH_OUTPUT_SIZE", "100000000")
+        )
+
+    def __call__(self, x=None, **kwargs):
+        if x is None:
+            x = kwargs.get("x")
+        if x is None:
+            raise TypeError("AisBenchRunner requires input `x`")
+
+        if isinstance(x, np.ndarray):
+            x = [x]
+
+        feeds = [np.ascontiguousarray(item) for item in x]
+        return self.session.infer(
+            feeds=feeds,
+            mode="dymshape",
+            custom_sizes=self.output_size,
+        )
+
+    def close(self):
+        close = getattr(self.session, "close", None)
+        if callable(close):
+            close()
